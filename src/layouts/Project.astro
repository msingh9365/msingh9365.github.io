---
import Base from './Base.astro';
import type { Project } from '../lib/projects';
import { tagLabel } from '../lib/projects';
import ProjectArt from '../components/ProjectArt.astro';
interface Props { project: Project; prev?: Project; next?: Project; }
const { project, prev, next } = Astro.props;
const d = project.data;
---
<Base title={d.title} description={d.summary} kind="Project">
  <div class="wrap page">
    <a class="mono back" href="/projects/" data-pagefind-ignore aria-label="Back to all projects">$ cd ..</a>
    <span class="kicker kicker-block" data-pagefind-ignore>{tagLabel(d.tag)} · {d.kind}</span>
    <h1 class="page-title project-title">{d.title}</h1>
    <p class="page-lede">{d.summary}</p>

    <div class="project-body">
      <article class="prose">
        <ProjectArt art={d.art} class="art-cover" />
        <slot />
      </article>
      <aside class="json" aria-label="Project facts">
        <div class="json-head" data-pagefind-ignore><span class="t-prompt">$</span> cat project.json</div>
        <pre class="json-body"><code>{'{'}
  <span class="jk">"status"</span>: <span class="js">"{d.status}"</span>,{d.period && <Fragment>{'\n  '}<span class="jk">"when"</span>: <span class="js">"{d.period}"</span>,</Fragment>}
  <span class="jk">"type"</span>: <span class="js">"{d.kind}"</span>,
  <span class="jk">"stack"</span>: [{d.stack.map((s, i) => <Fragment>{'\n    '}<span class="js">"{s}"</span>{i < d.stack.length - 1 ? ',' : ''}</Fragment>)}
  ],
  <span class="jk">"repo"</span>: {d.links.repo ? <a href={d.links.repo}>"{d.links.repo.replace(/^https:\/\//, '')}"</a> : <span class="jn">null</span>}{d.links.demo && <Fragment>,{'\n  '}<span class="jk">"demo"</span>: <a href={d.links.demo}>"{d.links.demo.replace(/^https:\/\//, '')}"</a></Fragment>}
{'}'}</code></pre>
      </aside>
    </div>

    <nav class="pager" aria-label="More projects">
      {prev ? <a href={`/projects/${prev.id}/`}>← {prev.data.title}</a> : <span />}
      {next ? <a href={`/projects/${next.id}/`}>{next.data.title} →</a> : <span />}
    </nav>
  </div>
</Base>
