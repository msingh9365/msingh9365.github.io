---
// Site search. The index is made by Pagefind after `astro build` (see package.json),
// so search only works on the built site (`npm run build && npm run preview`), not in `npm run dev`.
---
<button type="button" class="search-btn" data-search-open aria-label="Search the site" aria-keyshortcuts="/ Control+K Meta+K">
  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="11" cy="11" r="7" /><path d="M20 20l-3.5-3.5" /></svg>
  <span class="search-btn-label">search</span>
  <kbd aria-hidden="true">/</kbd>
</button>

<dialog class="search" data-search-dialog aria-label="Search the site">
  <div class="search-field">
    <span class="search-prompt" aria-hidden="true">&gt;</span>
    <label class="sr-only" for="search-input">Search the site</label>
    <input
      id="search-input"
      type="search"
      autocomplete="off"
      spellcheck="false"
      placeholder="search projects, tools, pages…"
      role="combobox"
      aria-expanded="false"
      aria-controls="search-results"
      aria-autocomplete="list"
    />
    <kbd aria-hidden="true">esc</kbd>
  </div>
  <div class="search-results" id="search-results" role="listbox" aria-label="Search results"></div>
  <p class="search-status" data-search-status aria-live="polite"></p>
  <div class="search-foot" aria-hidden="true"><span>↑↓ move</span><span>↵ open</span><span>esc close</span></div>
</dialog>

<script>
  interface PagefindData {
    url: string;
    excerpt: string;
    meta: { title?: string; type?: string };
  }
  interface PagefindApi {
    options: (o: Record<string, unknown>) => Promise<void>;
    debouncedSearch: (q: string, opts?: object, ms?: number) => Promise<{ results: { data: () => Promise<PagefindData> }[] } | null>;
  }

  const HINT = 'type to search projects, tools and pages';
  const GROUPS: [type: string, label: string][] = [['Project', 'PROJECTS'], ['Page', 'PAGES']];

  const openBtn = document.querySelector<HTMLButtonElement>('[data-search-open]')!;
  const dialog = document.querySelector<HTMLDialogElement>('[data-search-dialog]')!;
  const input = dialog.querySelector<HTMLInputElement>('#search-input')!;
  const list = dialog.querySelector<HTMLElement>('#search-results')!;
  const status = dialog.querySelector<HTMLElement>('[data-search-status]')!;

  let api: PagefindApi | null | undefined; // undefined = not loaded yet, null = not available
  let active = -1;

  async function loadApi(): Promise<PagefindApi | null> {
    if (api !== undefined) return api;
    try {
      const url = '/pagefind/pagefind.js';
      api = (await import(/* @vite-ignore */ url)) as PagefindApi;
      await api.options({ excerptLength: 18 });
    } catch {
      api = null;
    }
    return api;
  }

  function setStatus(text: string) {
    status.textContent = text;
    status.hidden = text === '';
  }

  /** Turns Pagefind's excerpt (text with <mark> tags) into safe DOM nodes, without using innerHTML. */
  function excerptNodes(html: string): Node[] {
    const doc = new DOMParser().parseFromString(`<p>${html}</p>`, 'text/html');
    const out: Node[] = [];
    doc.body.firstChild?.childNodes.forEach((n) => {
      if (n.nodeName === 'MARK') {
        const m = document.createElement('mark');
        m.textContent = n.textContent;
        out.push(m);
      } else {
        out.push(document.createTextNode(n.textContent ?? ''));
      }
    });
    return out;
  }

  const options = () => Array.from(list.querySelectorAll<HTMLAnchorElement>('[role="option"]'));

  function highlight(i: number) {
    const rows = options();
    if (!rows.length) {
      active = -1;
      input.removeAttribute('aria-activedescendant');
      return;
    }
    active = (i + rows.length) % rows.length;
    rows.forEach((r, n) => r.setAttribute('aria-selected', String(n === active)));
    input.setAttribute('aria-activedescendant', rows[active].id);
    rows[active].scrollIntoView({ block: 'nearest' });
  }

  function render(items: PagefindData[]) {
    list.replaceChildren();
    let n = 0;
    for (const [type, label] of GROUPS) {
      const group = items.filter((it) => (it.meta.type ?? 'Page') === type);
      if (!group.length) continue;
      const box = document.createElement('div');
      box.className = 'search-group';
      box.setAttribute('role', 'group');
      box.setAttribute('aria-label', label.toLowerCase());
      const head = document.createElement('div');
      head.className = 'search-group-label';
      head.setAttribute('aria-hidden', 'true');
      head.textContent = `## ${label}`;
      box.append(head);
      for (const it of group) {
        const a = document.createElement('a');
        a.className = 'search-row';
        a.href = it.url;
        a.id = `search-option-${n++}`;
        a.setAttribute('role', 'option');
        a.setAttribute('aria-selected', 'false');
        const title = document.createElement('span');
        title.className = 'search-row-title';
        title.textContent = it.meta.title ?? it.url;
        const line = document.createElement('span');
        line.className = 'search-row-line';
        line.append(...excerptNodes(it.excerpt));
        a.append(title, line);
        box.append(a);
      }
      list.append(box);
    }
    input.setAttribute('aria-expanded', String(items.length > 0));
    highlight(items.length ? 0 : -1);
  }

  async function runSearch() {
    const q = input.value.trim();
    if (!q) {
      render([]);
      setStatus(HINT);
      return;
    }
    const lib = await loadApi();
    if (!lib) {
      render([]);
      setStatus('search works on the built site (npm run build && npm run preview)');
      return;
    }
    const found = await lib.debouncedSearch(q, {}, 150);
    if (found === null) return; // a newer search replaced this one
    const items = await Promise.all(found.results.slice(0, 10).map((r) => r.data()));
    if (input.value.trim() !== q) return;
    render(items);
    setStatus(items.length ? '' : `no results for "${q}" — try a project, a tool (Spark, PyTorch) or a page`);
  }

  function openSearch() {
    if (dialog.open) return;
    dialog.showModal();
    input.focus();
    setStatus(HINT);
    void loadApi(); // start loading the index early
  }

  openBtn.addEventListener('click', openSearch);

  document.addEventListener('keydown', (e) => {
    const t = e.target as HTMLElement | null;
    const typing = !!t && (t.tagName === 'INPUT' || t.tagName === 'TEXTAREA' || t.tagName === 'SELECT' || t.isContentEditable);
    const slash = e.key === '/' && !e.metaKey && !e.ctrlKey && !e.altKey && !typing;
    const cmdK = e.key.toLowerCase() === 'k' && (e.metaKey || e.ctrlKey) && !e.altKey;
    if (slash || cmdK) {
      e.preventDefault();
      openSearch();
    }
  });

  input.addEventListener('input', () => void runSearch());
  input.addEventListener('keydown', (e) => {
    if (e.key === 'ArrowDown') { e.preventDefault(); highlight(active + 1); }
    else if (e.key === 'ArrowUp') { e.preventDefault(); highlight(active - 1); }
    else if (e.key === 'Enter') {
      const row = options()[active];
      if (row) { e.preventDefault(); row.click(); }
    }
    // A search field with text would only clear itself on Esc; close the whole box in one press.
    else if (e.key === 'Escape') { e.preventDefault(); dialog.close(); }
  });

  // Clicking the dark area outside the box closes it.
  dialog.addEventListener('click', (e) => { if (e.target === dialog) dialog.close(); });
  dialog.addEventListener('close', () => {
    input.value = '';
    render([]);
  });
</script>
