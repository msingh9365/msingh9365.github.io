---
import type { Project } from '../lib/projects';
import { tagLabel, yearOf } from '../lib/projects';
import ProjectArt from './ProjectArt.astro';
interface Props { project: Project; }
const { project } = Astro.props;
const d = project.data;
---
<article class="card">
  <ProjectArt art={d.art} />
  <div class="card-body">
    <span class="kicker">{tagLabel(d.tag)}{d.period && ` · ${yearOf(d.period)}`}</span>
    <h3><a href={`/projects/${project.id}/`}>{d.title}</a></h3>
    <p>{d.summary}</p>
    <span class="card-cta" aria-hidden="true">$ open {project.id}</span>
  </div>
</article>
