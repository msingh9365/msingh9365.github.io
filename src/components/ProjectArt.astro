---
// Small diagrams for each project. They use theme colours (see .art in components.css),
// so they switch with light/dark mode. To add one: add a key here and in content.config.ts.
interface Props { art: 'cbir' | 'youtube' | 'music' | 'court' | 'fraud'; class?: string; }
const { art, class: className } = Astro.props;
const labels = {
  cbir: 'Diagram: a query image compared against a grid of results using six retrieval methods.',
  youtube: 'Diagram: a four-step pipeline from ingest to process, aggregate and serve.',
  music: 'Diagram: an audio waveform turned into features, then classified into a genre.',
  court: 'Diagram: a weekly grid of court time slots with one slot booked.',
  fraud: 'Diagram: transactions flowing through Kafka and Spark Streaming, with one flagged as fraud.',
