---
import Base from '../layouts/Base.astro';
import { now } from '../data/now';
---
<Base title="Now" description="What Manish Singh is working on right now.">
  <div class="wrap page">
    <div class="now-page">
      <h1 class="page-title">Now</h1>
      <p class="meta">Last updated {now.updated}. A snapshot of what I'm doing, not a plan.</p>
      <div class="now-list">
        {now.items.map((i) => <div><span class="kicker">{i.kicker}</span><p>{i.text}</p></div>)}
      </div>
      <h2 class="eyebrow">EARLIER</h2>
      <ul class="earlier">
        {now.earlier.map((e) => <li><span class="meta">{e.date}</span><span>{e.text}</span></li>)}
      </ul>
    </div>
  </div>
</Base>
