---
import Base from '../layouts/Base.astro';
---
<Base title="Page not found" description="This page does not exist.">
  <div class="wrap notfound">
    <span class="kicker kicker-block">404</span>
    <h1 class="page-title">This page doesn't exist.</h1>
    <p class="page-lede">The link may be old, or the address may have a typo.</p>
    <div class="actions">
      <a class="btn btn-primary" href="/">Go home</a>
      <a class="btn" href="/projects/">See projects</a>
    </div>
  </div>
</Base>
